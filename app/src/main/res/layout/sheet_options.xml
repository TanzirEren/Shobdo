<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="22dp" android:background="@color/bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Caption settings" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:text="Language or mix" android:textColor="@color/sub" android:textSize="12sp" />
    <Spinner android:id="@+id/spLang" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Script of the captions" android:textColor="@color/sub" android:textSize="12sp" />
    <Spinner android:id="@+id/spScript" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/wordsLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Words per caption: 4" android:textColor="@color/sub" android:textSize="12sp" />
    <SeekBar android:id="@+id/seekWords" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:max="7" android:progress="2" />
    <CheckBox android:id="@+id/cbTranslate" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Translate everything to English" />
    <CheckBox android:id="@+id/cbFillers" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Remove filler words (um, uh…)" />
    <TextView android:id="@+id/go" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:background="@drawable/bg_btn" android:gravity="center"
        android:paddingVertical="15dp" android:text="Generate captions" android:textColor="#FFFFFF"
        android:textSize="16sp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
