<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="#EDE7FF" /><corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="@color/violet" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/surface" /><corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/line" /></shape>
    </item>
</selector>
