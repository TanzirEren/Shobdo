<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#558B5CFF" android:endColor="#33FF5FA2" />
            <corners android:radius="18dp" />
            <stroke android:width="1.2dp" android:color="#B89CFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#2BFFFFFF" android:endColor="#0FFFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="0.8dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
